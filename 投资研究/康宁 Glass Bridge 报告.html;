<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=1920, initial-scale=1">
<title>康宁 Glass Bridge · 研究报告拆解 · 12 页</title>
<style>
/* ============== TOKENS ============== */
:root {
  --c-bg:        #0b0f14;
  --c-bg-2:      #111722;
  --c-bg-3:      #1a2230;
  --c-panel:     #1e2738;
  --c-line:      rgba(255,255,255,0.08);
  --c-line-2:    rgba(255,255,255,0.16);
  --c-ink:       #f3f5f8;
  --c-ink-2:     #c8d0dc;
  --c-ink-3:     #8a95a8;
  --c-ink-4:     #5b6678;
  --c-accent:    #3da9fc;
  --c-accent-2:  #1f7ad6;
  --c-amber:     #f0a648;
  --c-green:     #4ec07a;
  --c-red:       #e15554;
  --f-display:   "Source Han Serif SC", "Noto Serif SC", "Songti SC", serif;
  --f-body:      "PingFang SC", -apple-system, "Microsoft YaHei", sans-serif;
  --f-mono:      "JetBrains Mono", "SF Mono", "Consolas", monospace;
  --fs-1: 96px; --fs-2: 64px; --fs-3: 44px; --fs-4: 32px;
  --fs-5: 24px; --fs-6: 18px; --fs-7: 14px;
}

/* ============== BASE ============== */
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; }
body {
  background: var(--c-bg);
  color: var(--c-ink);
  font-family: var(--f-body);
  font-size: var(--fs-6);
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* =============== DECK STAGE =============== */
#stage {
  position: fixed;
  top: 0; left: 0;
  width: 1920px;
  height: 1080px;
  background: var(--c-bg);
  transform-origin: top left;
  box-shadow: 0 10px 60px rgba(0,0,0,0.4);
}
.slide {
  position: absolute;
  top: 0; left: 0;
  width: 1920px;
  height: 1080px;
  display: none;
  overflow: hidden;
  background: var(--c-bg);
}
.slide.active { display: block; }

/* ============== CHROME ============== */
.slide-header {
  position: absolute;
  top: 56px; left: 96px; right: 96px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  font-family: var(--f-mono);
  font-size: var(--fs-7);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--c-ink-4);
  z-index: 5;
}
.slide-header .brand { color: var(--c-accent); }
.slide-header .pageno { font-variant-numeric: tabular-nums; }

.slide-footer {
  position: absolute;
  bottom: 48px; left: 96px; right: 96px;
  display: flex;
  justify-content: space-between;
  font-family: var(--f-mono);
  font-size: var(--fs-7);
  letter-spacing: 0.1em;
  color: var(--c-ink-4);
  border-top: 1px solid var(--c-line);
  padding-top: 20px;
  z-index: 5;
}

.h-eyebrow {
  font-family: var(--f-mono);
  font-size: var(--fs-7);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--c-accent);
  margin-bottom: 18px;
}
.h-title {
  font-family: var(--f-display);
  font-size: var(--fs-2);
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.15;
  color: var(--c-ink);
  margin-bottom: 28px;
}
.h-title em { font-style: normal; color: var(--c-accent); }
.h-subtitle {
  font-size: var(--fs-5);
  color: var(--c-ink-2);
  line-height: 1.5;
  max-width: 1600px;
}
.section-title {
  font-family: var(--f-display);
  font-size: var(--fs-3);
  font-weight: 600;
  color: var(--c-ink);
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.section-title em { font-style: normal; color: var(--c-accent); }
.section-title::before {
  content: ""; display: block; width: 4px; height: 36px; background: var(--c-accent);
}

.tag {
  display: inline-block;
  padding: 4px 12px;
  font-family: var(--f-mono);
  font-size: var(--fs-7);
  letter-spacing: 0.08em;
  border-radius: 999px;
  background: rgba(61,169,252,0.12);
  color: var(--c-accent);
}
.tag.amber { background: rgba(240,166,72,0.12); color: var(--c-amber); }
.tag.green { background: rgba(78,192,122,0.12); color: var(--c-green); }
.tag.red   { background: rgba(225,85,84,0.12); color: var(--c-red); }
.tag.muted { background: rgba(255,255,255,0.06); color: var(--c-ink-3); }

/* ============== NAV CHROME ============== */
.counter {
  position: fixed; bottom: 20px; right: 24px;
  background: rgba(11,15,20,0.85);
  border: 1px solid rgba(255,255,255,0.08);
  color: #fff; padding: 8px 16px;
  border-radius: 999px; font-size: 13px;
  font-variant-numeric: tabular-nums;
  z-index: 100; user-select: none;
}
.counter .label { color: rgba(255,255,255,0.55); margin-left: 10px; }

.toc-btn {
  position: fixed; bottom: 20px; left: 24px;
  background: rgba(11,15,20,0.85);
  border: 1px solid rgba(255,255,255,0.08);
  color: #c8d0dc; padding: 8px 16px;
  border-radius: 999px; font-size: 13px;
  z-index: 100; cursor: pointer; user-select: none;
}
.toc-btn:hover { background: rgba(61,169,252,0.12); color: var(--c-accent); }

.toc-panel {
  position: fixed; top: 0; left: 0;
  width: 420px; height: 100%;
  background: rgba(11,15,20,0.96);
  border-right: 1px solid var(--c-line-2);
  padding: 80px 40px 40px;
  transform: translateX(-100%);
  transition: transform 0.3s;
  z-index: 200; overflow-y: auto;
}
.toc-panel.open { transform: translateX(0); }
.toc-panel h3 {
  font-family: var(--f-display); font-size: 22px;
  color: var(--c-ink); margin-bottom: 24px;
}
.toc-item {
  display: flex; align-items: center; gap: 14px;
  padding: 14px 0;
  border-bottom: 1px solid rgba(255,255,255,0.05);
  color: var(--c-ink-3); font-size: 15px;
  cursor: pointer;
}
.toc-item:hover { color: var(--c-accent); }
.toc-item.active { color: var(--c-ink); }
.toc-num { font-family: var(--f-mono); font-size: 13px; color: var(--c-ink-4); min-width: 32px; }
.toc-item.active .toc-num { color: var(--c-accent); }

.nav-zone {
  position: fixed; top: 0; bottom: 0;
  width: 12%; cursor: pointer; z-index: 50;
}
.nav-zone.left { left: 0; }
.nav-zone.right { right: 0; }
.nav-hint {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 48px; height: 48px; border-radius: 999px;
  background: rgba(255,255,255,0.06);
  color: rgba(255,255,255,0.55);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; opacity: 0; transition: opacity 0.2s;
}
.nav-zone.left .nav-hint { left: 24px; }
.nav-zone.right .nav-hint { right: 24px; }
.nav-zone:hover .nav-hint { opacity: 1; }

/* Print: each slide 1920x1080, page-break */
@media print {
  @page { size: 1920px 1080px; margin: 0; }
  html, body { background: #fff; overflow: visible; height: auto; }
  #stage { position: static; transform: none !important; box-shadow: none; }
  .counter, .nav-zone, .toc-btn, .toc-panel { display: none !important; }
  .slide { display: block; page-break-after: always; position: relative; }
}

/* ============== SLIDE 01 · COVER ============== */
.s1 { background: radial-gradient(ellipse at 30% 20%, #1a2540 0%, #0b0f14 65%); display: none; }
.s1 .cover-wrap {
  position: relative; width: 100%; height: 100%;
  display: grid; grid-template-columns: 1fr 1fr;
  align-items: center; padding: 0 120px;
}
.s1 .cover-eyebrow {
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.32em; color: var(--c-accent);
  margin-bottom: 32px; text-transform: uppercase;
}
.s1 .cover-title {
  font-family: var(--f-display); font-size: 132px;
  font-weight: 700; line-height: 1.05;
  letter-spacing: -0.02em; color: var(--c-ink);
  margin-bottom: 24px;
}
.s1 .cover-title em { font-style: normal; color: var(--c-accent); }
.s1 .cover-sub {
  font-size: var(--fs-4); color: var(--c-ink-2);
  line-height: 1.5; margin-bottom: 56px; max-width: 800px;
}
.s1 .cover-meta {
  display: flex; gap: 56px;
  font-family: var(--f-mono); font-size: var(--fs-6);
  color: var(--c-ink-3);
}
.s1 .cover-meta span { color: var(--c-ink-2); }
.s1 .cover-right {
  position: relative; height: 800px;
  display: flex; align-items: center; justify-content: center;
}
.s1 .glass-art { position: relative; width: 640px; height: 640px; }
.s1 .glass-ring {
  position: absolute; border: 1px solid var(--c-line-2);
  border-radius: 50%; inset: 0;
}
.s1 .glass-ring:nth-child(2) { inset: 60px; border-color: rgba(61,169,252,0.25); }
.s1 .glass-ring:nth-child(3) { inset: 140px; border-color: rgba(61,169,252,0.45); }
.s1 .glass-ring:nth-child(4) { inset: 220px; border-style: dashed; border-color: rgba(240,166,72,0.5); }
.s1 .glass-center {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  width: 200px; height: 200px; border-radius: 24px;
  background: linear-gradient(135deg, rgba(61,169,252,0.18), rgba(31,122,214,0.05));
  border: 2px solid var(--c-accent);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-mono); font-size: 22px;
  letter-spacing: 0.18em; color: var(--c-accent);
  box-shadow: 0 0 80px rgba(61,169,252,0.35);
}
.s1 .glass-node {
  position: absolute; width: 14px; height: 14px;
  border-radius: 50%; background: var(--c-amber);
  box-shadow: 0 0 24px var(--c-amber);
}
.s1 .glass-node.n1 { top: 80px; left: 50%; transform: translateX(-50%); }
.s1 .glass-node.n2 { top: 50%; right: 80px; transform: translateY(-50%); }
.s1 .glass-node.n3 { bottom: 80px; left: 50%; transform: translateX(-50%); }
.s1 .glass-node.n4 { top: 50%; left: 80px; transform: translateY(-50%); }
.s1 .glass-label {
  position: absolute; font-family: var(--f-mono);
  font-size: 13px; letter-spacing: 0.12em; color: var(--c-ink-3);
}
.s1 .glass-label.l1 { top: 50px; left: 50%; transform: translateX(-50%); color: var(--c-amber); }
.s1 .glass-label.l2 { top: 50%; right: 20px; transform: translateY(-50%); }
.s1 .glass-label.l3 { bottom: 50px; left: 50%; transform: translateX(-50%); }
.s1 .glass-label.l4 { top: 50%; left: 20px; transform: translateY(-50%); }
.s1 .cover-stamp {
  position: absolute; bottom: 80px; left: 120px;
  font-family: var(--f-mono); font-size: var(--fs-7);
  color: var(--c-ink-4); letter-spacing: 0.15em;
}

/* ============== SLIDE 02 · SUMMARY ============== */
.s2 .body { position: absolute; top: 168px; left: 96px; right: 96px; bottom: 130px;
  display: grid; grid-template-rows: auto 1fr auto; gap: 32px; }
.s2 .headline {
  font-family: var(--f-display); font-size: var(--fs-3);
  color: var(--c-ink); line-height: 1.3; margin-bottom: 12px;
}
.s2 .headline em { font-style: normal; color: var(--c-accent); }
.s2 .three { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; }
.s2 .col {
  background: var(--c-bg-2); border: 1px solid var(--c-line);
  border-radius: 16px; padding: 36px 32px;
  position: relative; overflow: hidden;
}
.s2 .col::before {
  content: ""; position: absolute; top: 0; left: 0;
  width: 60px; height: 4px; background: var(--c-accent);
}
.s2 .col.amber::before { background: var(--c-amber); }
.s2 .col.red::before   { background: var(--c-red); }
.s2 .col-num {
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.2em; color: var(--c-ink-4); margin-bottom: 16px;
}
.s2 .col-title {
  font-family: var(--f-display); font-size: var(--fs-4);
  font-weight: 600; margin-bottom: 20px; line-height: 1.3;
}
.s2 .col-body { font-size: var(--fs-6); color: var(--c-ink-2); line-height: 1.7; }
.s2 .col-body strong { color: var(--c-ink); font-weight: 600; }
.s2 .bottom {
  display: grid; grid-template-columns: repeat(5, 1fr);
  border: 1px solid var(--c-line); border-radius: 12px; overflow: hidden;
}
.s2 .bb {
  padding: 20px 24px; border-right: 1px solid var(--c-line); background: var(--c-bg-2);
}
.s2 .bb:last-child { border-right: 0; }
.s2 .bb .num {
  font-family: var(--f-mono); font-size: var(--fs-3);
  font-weight: 600; color: var(--c-accent); line-height: 1;
}
.s2 .bb .lbl {
  font-size: var(--fs-7); color: var(--c-ink-3);
  margin-top: 8px; letter-spacing: 0.06em;
}

/* ============== SLIDE 03 · CONTEXT ============== */
.s3 .body { position: absolute; top: 168px; left: 96px; right: 96px; bottom: 130px;
  display: grid; grid-template-columns: 1fr 1.1fr; gap: 64px; }
.s3 .prose {
  font-size: var(--fs-5); color: var(--c-ink-2);
  line-height: 1.7; margin-bottom: 28px;
}
.s3 .prose strong { color: var(--c-ink); }
.s3 .prose em { font-style: normal; color: var(--c-accent); }
.s3 .drive-stack { display: flex; flex-direction: column; gap: 12px; margin-top: 32px; }
.s3 .drive {
  display: flex; gap: 18px; padding: 16px 20px;
  background: var(--c-bg-2); border-left: 3px solid var(--c-accent);
  border-radius: 0 8px 8px 0;
  font-size: var(--fs-6); color: var(--c-ink-2);
}
.s3 .drive .num {
  font-family: var(--f-mono); color: var(--c-accent);
  font-weight: 600; min-width: 36px;
}
.s3 .context-art {
  background: var(--c-bg-2); border: 1px solid var(--c-line);
  border-radius: 16px; padding: 32px;
  height: 100%; display: flex; flex-direction: column;
}
.s3 .art-title {
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.18em; color: var(--c-accent);
  margin-bottom: 24px; text-transform: uppercase;
}
.s3 .flow { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
.s3 .flow-row {
  display: grid; grid-template-columns: 140px 1fr 80px;
  gap: 18px; align-items: center;
  padding: 12px 0; border-bottom: 1px dashed var(--c-line);
}
.s3 .flow-row:last-child { border-bottom: 0; }
.s3 .flow-label {
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.06em; color: var(--c-ink-3);
}
.s3 .flow-bar { height: 10px; border-radius: 5px;
  background: linear-gradient(90deg, var(--c-accent), var(--c-amber)); }
.s3 .flow-bar.b1 { width: 35%; }
.s3 .flow-bar.b2 { width: 55%; }
.s3 .flow-bar.b3 { width: 78%; }
.s3 .flow-bar.b4 { width: 92%; background: linear-gradient(90deg, var(--c-amber), var(--c-red)); }
.s3 .flow-bar.b5 { width: 68%; }
.s3 .flow-val {
  font-family: var(--f-mono); font-size: var(--fs-6);
  color: var(--c-amber); font-weight: 600; text-align: right;
}
.s3 .insight {
  margin-top: 24px; padding: 18px 22px;
  background: rgba(61,169,252,0.06); border-radius: 8px;
  font-size: var(--fs-6); color: var(--c-ink-2); line-height: 1.6;
}
.s3 .insight strong { color: var(--c-accent); }

/* ============== SLIDE 04 · TECH OVERVIEW ============== */
.s4 .body { position: absolute; top: 168px; left: 96px; right: 96px; bottom: 130px;
  display: grid; grid-template-rows: auto 1fr; gap: 32px; }
.s4 .layer-diagram {
  background: var(--c-bg-2); border: 1px solid var(--c-line);
  border-radius: 16px; padding: 40px 56px;
  display: grid; grid-template-columns: 1fr 80px 1fr;
  gap: 24px; align-items: center;
}
.s4 .layer-box {
  padding: 32px 36px; background: var(--c-bg-3);
  border-radius: 12px; border: 1px solid var(--c-line-2);
  position: relative;
}
.s4 .layer-box.outer {
  background: linear-gradient(135deg, rgba(240,166,72,0.12), rgba(31,122,214,0.06));
  border: 2px solid var(--c-amber);
}
.s4 .layer-box.inner {
  background: linear-gradient(135deg, rgba(61,169,252,0.18), rgba(31,122,214,0.06));
  border: 2px solid var(--c-accent);
}
.s4 .layer-eyebrow {
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.18em; color: var(--c-ink-4); margin-bottom: 12px;
}
.s4 .layer-name {
  font-family: var(--f-display); font-size: var(--fs-2);
  font-weight: 700; margin-bottom: 16px;
}
.s4 .layer-box.outer .layer-name { color: var(--c-amber); }
.s4 .layer-box.inner .layer-name { color: var(--c-accent); }
.s4 .layer-desc { font-size: var(--fs-6); color: var(--c-ink-2); line-height: 1.6; margin-bottom: 20px; }
.s4 .layer-bullets { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.s4 .layer-bullets li {
  font-size: var(--fs-7); color: var(--c-ink-3);
  font-family: var(--f-mono); padding-left: 16px; position: relative;
}
.s4 .layer-bullets li::before { content: "›"; position: absolute; left: 0; color: inherit; }
.s4 .arrow {
  display: flex; flex-direction: column; align-items: center;
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.18em; color: var(--c-ink-4); text-align: center;
}
.s4 .arrow .glyph { font-size: 56px; color: var(--c-accent); line-height: 1; margin-bottom: 8px; }
.s4 .key-insight {
  margin-top: 24px; padding: 20px 28px;
  background: rgba(240,166,72,0.08); border-left: 4px solid var(--c-amber);
  border-radius: 0 8px 8px 0;
  font-size: var(--fs-5); color: var(--c-ink); line-height: 1.6;
}
.s4 .key-insight strong { color: var(--c-amber); }

/* ============== SLIDE 05 · IOX ============== */
.s5 .body { position: absolute; top: 168px; left: 96px; right: 96px; bottom: 130px;
  display: grid; grid-template-columns: 1fr 1.1fr; gap: 56px; }
.s5 .prose {
  font-size: var(--fs-5); color: var(--c-ink-2);
  line-height: 1.7; margin-bottom: 24px;
}
.s5 .prose strong { color: var(--c-ink); }
.s5 .prose em { font-style: normal; color: var(--c-accent); }
.s5 .spec-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 24px; }
.s5 .spec {
  background: var(--c-bg-2); border: 1px solid var(--c-line);
  border-radius: 10px; padding: 20px 24px;
}
.s5 .spec .label {
  font-family: var(--f-mono); font-size: var(--fs-7);
  color: var(--c-ink-4); letter-spacing: 0.12em;
  margin-bottom: 8px; text-transform: uppercase;
}
.s5 .spec .val {
  font-family: var(--f-display); font-size: var(--fs-3);
  font-weight: 600; color: var(--c-accent); line-height: 1;
}
.s5 .spec .unit { font-family: var(--f-mono); font-size: var(--fs-6); color: var(--c-ink-3); margin-left: 4px; }
.s5 .spec .note { font-size: var(--fs-7); color: var(--c-ink-3); margin-top: 8px; }
.s5 .process-card {
  background: var(--c-bg-2); border: 1px solid var(--c-line);
  border-radius: 16px; padding: 32px;
  height: 100%; display: flex; flex-direction: column;
}
.s5 .process-title {
  font-family: var(--f-mono); font-size: var(--fs-7);
  letter-spacing: 0.18em; color: var(--c-accent);
  margin-bottom: 24px; text-transform: uppercase;
}
.s5 .steps { flex: 1; display: flex; flex-direction: column; gap: 16px; }
.s5 .step {
  display: grid; grid-template-columns: 60px 1fr; gap: 20px;
  align-items: start; padding: 20px; background: var(--c-bg-3);
  border-radius: 10px; border-left: 3px solid var(--c-accent);
}
.s5 .step:nth-child(2) { border-left-color: var(--c-amber); }
.s5 .step:nth-child(3) { border-left-color: var(--c-green); }
.s5 .step .num {
  font-family: var(--f-mono); font-size: 48px;
  font-weight: 700; color: var(--c-accent); line-height: 1; opacity: 0.85;
}
.s5 .step:nth-child(2) .num { color: var(--c-amber); }
.s5 .step:nth-child(3) .num { color: var(--c-green); }
.s5 .step .head {
  font-family: var(--f-display); font-size: var(--fs-5);
  font-weight: 600; color: var(--c-ink); margin-bottom: 8px;
}
.s5 .step .desc {
  font-size: var(--fs-7); color: var(--c-ink-3);
  line-height: 1.6; font-family: var(--f-mono);
}
.s5 .goal {
  margin-top: 20px; padding: 16px 20px;
  background: rgba(78,192,122,0.08); border-radius: 8px;
